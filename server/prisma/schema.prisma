// -----------------------
// Fragrance Finder / Quiz
// -----------------------

enum FragranceQuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  IMAGE_CHOICE
  ICON_CHOICE
  YES_NO
  SLIDER
}

enum FragranceRuleOperator {
  AND
  OR
}

model FragranceQuiz {
  id              String   @id @default(uuid())
  title           String   @default("Fragrance Finder")
  description     String?
  heroImage       String?
  isActive        Boolean  @default(true)
  showResults     Boolean  @default(true)
  maxQuestions    Int      @default(15)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  questions       FragranceQuizQuestion[]
  responses       FragranceQuizResponse[]
  rules           FragranceQuizRule[]
}

model FragranceQuizQuestion {
  id              String                @id @default(uuid())
  quizId          String
  title           String
  description     String?
  questionType    FragranceQuestionType @default(SINGLE_CHOICE)
  isRequired      Boolean               @default(true)
  isActive        Boolean               @default(true)
  image           String?
  order           Int                   @default(0)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  quiz            FragranceQuiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options         FragranceQuizOption[]
  ruleConditions  FragranceQuizRuleCondition[]
  responseAnswers FragranceQuizResponseAnswer[]

  @@index([quizId])
  @@index([order])
}

model FragranceQuizOption {
  id              String   @id @default(uuid())
  questionId      String
  title           String
  description     String?
  image           String?
  icon            String?
  score           Int      @default(1)
  tags            String[] @default([])
  priority        Int      @default(0)
  order           Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  question        FragranceQuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  ruleConditions  FragranceQuizRuleCondition[]
  responseAnswers FragranceQuizResponseAnswer[]

  @@index([questionId])
  @@index([order])
}

model FragranceQuizRule {
  id              String   @id @default(uuid())
  quizId          String
  name            String
  description     String?
  operator        FragranceRuleOperator @default(AND)
  priority        Int      @default(0)
  weight          Float    @default(1.0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  quiz            FragranceQuiz               @relation(fields: [quizId], references: [id], onDelete: Cascade)
  conditions      FragranceQuizRuleCondition[]
  products        FragranceQuizRuleProduct[]

  @@index([quizId])
  @@index([priority])
}

model FragranceQuizRuleCondition {
  id              String   @id @default(uuid())
  ruleId          String
  questionId      String
  optionId        String
  createdAt       DateTime @default(now())

  rule            FragranceQuizRule      @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  question        FragranceQuizQuestion  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  option          FragranceQuizOption    @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([ruleId, questionId, optionId])
  @@index([ruleId])
}

model FragranceQuizRuleProduct {
  id              String   @id @default(uuid())
  ruleId          String
  productId       String
  priority        Int      @default(0)
  createdAt       DateTime @default(now())

  rule            FragranceQuizRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  product         Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([ruleId, productId])
  @@index([ruleId])
}

model FragranceQuizResponse {
  id                  String   @id @default(uuid())
  quizId              String?
  userId              String?
  guestId             String?
  sessionId           String?
  answers             Json     @default("[]")
  recommendedProducts Json     @default("[]")
  matchedRuleId       String?
  timeTaken           Int?
  device              String?
  browser             String?
  ipAddress           String?
  completed           Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  quiz                FragranceQuiz?       @relation(fields: [quizId], references: [id], onDelete: SetNull)
  user                User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  responseAnswers     FragranceQuizResponseAnswer[]

  @@index([userId])
  @@index([guestId])
  @@index([createdAt])
}

model FragranceQuizResponseAnswer {
  id          String   @id @default(uuid())
  responseId  String
  questionId  String
  optionId    String?
  value       String?
  createdAt   DateTime @default(now())

  response    FragranceQuizResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question    FragranceQuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  option      FragranceQuizOption?  @relation(fields: [optionId], references: [id], onDelete: SetNull)

  @@index([responseId])
  @@index([questionId])
}

